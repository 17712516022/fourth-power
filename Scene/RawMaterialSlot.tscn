text = "今天大半时间都在跟\"点不动\"这三个字较劲。
早上先把开始菜单收了尾——按下\"开始\"之后，素材池里立刻就有六条东西可以挑，不用再白点一次\"决定\"才能拿到第一条。顺手把之前手工填的素材配图也理清了，八十个素材文件现在都带着图。
中间一大块在折腾素材池怎么摆。本来想一行排开、滚轮看后面的，试了好几种摆法都别扭——有一次还把\"滚动条\"当成了\"能装东西的格子\"来用，六张卡片全堆在左上角糊成一团。最后定下来是\"外面套一层能滚动的窗口，里面横着排一行\"，滚轮上下滚会自己变成左右滚，凑合能用。
下半天的重头戏是那个弹出来的详情面板。弹出来之后，鼠标点它背后的素材，居然还能点中。这个过程走得"
autowrap_mode = 1

[node name="SlotColumn2" type="Label" parent="VBoxContainer/SlotColumns" unique_id=1318455602]
custom_minimum_size = Vector2(97, 150)
custom_maximum_size = Vector2(97, 150)
