extends Node

# ============================================================================
#  报纸把门槛推向哪一边
#
#  返回一个数，由 Group 累加成 push。**它不改属性，只改门槛。**
#
#    正 = 退 —— 怒的门槛升（更难闹）、怕的门槛降（更容易跑）
#    负 = 进 —— 怒的门槛降（更敢闹）、怕的门槛升（撑得住）
#
#  为什么整份报纸只有一个方向：一张说"四乡都在抗租"的报纸，
#  不可能同时让人觉得"该闹"和"会挨打"——那是两份报纸。
#  所以每条消息只贡献一个符号，累加起来就是这个版面总的态度。
#
#  "哪条消息属于哪一类"是**规则**，留在 Group._push_of()；
#  推多少是**数值**，全在这里。
# ============================================================================

# 同类在闹——"原来不止我一个"，更敢
func push_of_peers() -> float:
	return -0.040

# 同类走了（逃荒、外逃、溃散）——"这地方待不下去"，退
func push_of_exodus() -> float:
	return +0.050

# 政府动手——闹事者一律拿办，退
func push_of_suppress() -> float:
	return +0.060

# 政府收手——风声松了，进
func push_of_relief() -> float:
	return -0.035

# 别家在闹——不关我的事，但"别人闹了也没事"会让人多一点胆
func push_of_others() -> float:
	return -0.015


# ============================================================================
#  行动对自己的反作用
#  "哪个状态有代价"是规则，留在各家的 _act()；
#  代价是多少全在这里。
# ============================================================================

# 抗租：出一口气，但底气被烧、怕在慢慢积累
func farmer_resist() -> Dictionary:
	return {"angry" : -0.020, "power" : -0.015, "fear" : 0.012}

# 怠工：磨洋工不泄气——它离"涨工钱"一步都没近，所以怒气反而继续涨。
# 这是工人能自己升到罢工的燃料。
func worker_slowdown() -> Dictionary:
	return {"angry" : 0.004, "power" : -0.004, "fear" : 0.006}

# 罢工：真的出了气，但停工没工资，底气烧得最快
func worker_strike() -> Dictionary:
	return {"angry" : -0.035, "power" : -0.020, "fear" : 0.025}

# 囤积：离"把货变成钱"一步没近，所以也急。但比怠工轻——货在仓库里，价钱还在涨。
func merchant_hoard() -> Dictionary:
	return {"angry" : 0.002, "power" : 0.003, "fear" : 0.003}

# 罢市：明确的表态，出了气。而停业几乎不亏本——物价被自己推上去了，
# 仓里的货更值钱。商人能耗，就耗在这里。
func merchant_closeshop() -> Dictionary:
	return {"angry" : -0.030, "power" : -0.002, "fear" : 0.010}

# 消极执勤：该发的饷没发，该打的仗还得打。所以怒气继续涨。
func soldier_slack() -> Dictionary:
	return {"angry" : 0.003, "power" : -0.008, "fear" : 0.004}

# 哗变：明确的表态，出了气。但编制在这一步开始真散——人各干各的，指挥链断了。
func soldier_mutiny() -> Dictionary:
	return {"angry" : -0.025, "power" : -0.015, "fear" : 0.030}
