[resource]
script = ExtResource("1_8xqk5")
headline = "讽刺画：新衣服"
body = "　　本报特约画师这一期画了一幅讽刺画：一个人穿着崭新的礼服站在田埂上，四周的禾苗都枯了，他却低着头看自己的袖口。
　　画下面一个字也没写，也没有署名，只在角落里盖了个小印章。
　　画登出来以后，茶馆里有人议论，说画的是谁不好讲；也有人笑着说，反正穿新衣服的人不下地。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
