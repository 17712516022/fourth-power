[resource]
script = ExtResource("1_news")
headline = "织坊招六十女工"
body = "　　城东织坊新添了一批纺机，现在要再招六十名女工、四十名杂工。
　　女工每天一角二分银币，杂工一角。中午管一顿饭，工房可以住，住的每月扣两角房钱。
　　报名时间是每天下午两点到六点，在织坊门口，带上身份证明就行。手脚快的另有计件工资。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
