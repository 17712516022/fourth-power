[resource]
script = ExtResource("1_news")
headline = "学院招插班生"
body = "　　本城学院定在下个月一号招收插班生，一共四十名，年龄八岁到十四岁。
　　报名要求认得一些字，当天先考一场，考识字和算术。学费每学期一银币二角，家里困难的可以少收。
　　学院说，今年报名的人比去年多，名额有限，考完三天之内放榜。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
