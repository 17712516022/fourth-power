[resource]
script = ExtResource("1_news")
headline = "老晋隆到外国货"
body = "　　大街一百二十八号的老晋隆商行，这两天刚到了一批外国货，有座钟、呢绒、蜡烛、灯油、铁钉和颜料，还有几台织布机。
　　东西不贵，做得也结实，整批买还能再便宜一点。存货不多，座钟和呢绒都只剩十几件，卖完得等下一班船。
　　店里批发零售都做，早上八点开门，天黑以前关门。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
