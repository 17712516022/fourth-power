[resource]
script = ExtResource("1_news")
headline = "铁匠巷起火"
body = "　　昨晚十一点左右，城南铁匠巷有户人家的灶上着了火。夜里风大，火顺着屋檐烧开，十多间平房全烧没了。
　　救火队赶到的时候，半条巷子已经在烧，水车来回跑了七八趟，到天亮才把火扑灭。没有死人，只有两个人被烟呛到。
　　起火的原因还在查。巷口已经封了，住在那一带的人暂时挤到附近的客栈里。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
