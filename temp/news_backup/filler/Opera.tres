[resource]
script = ExtResource("1_news")
headline = "剧院今晚开演"
body = "　　同乐剧院从今晚起演全本《断剑与蔷薇》，连演三天，每晚七点半开演。
　　剧场里新装了几盏符文灯，散场以后还加开夜场。票价包厢四角，正厅二角，站票一角。
　　剧院说，包厢已经订出去大半，头一晚只剩两边几个。想坐正厅的，最好提前半个钟头去排队。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
