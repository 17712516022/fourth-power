[resource]
script = ExtResource("1_sa4ai")
headline = "小说连载第七回"
body = "　　上一回说到约翰告别家乡，一个人往城里去。这一回，他走到了城门口，钱袋里只剩三个铜板。
　　守门的两个士兵上下打量他，问他叫什么、从哪儿来、进城干什么。约翰答得慢，一只手一直按在钱袋上。
　　后面排队的人开始催，其中一个士兵忽然笑了，摆摆手让他过去。约翰走进城门，天正好黑下来。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
