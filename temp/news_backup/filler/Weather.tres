[resource]
script = ExtResource("1_tjmaw")
headline = "雨下不停，秋收往后拖"
body = "　　本城入秋以来一直在下雨，城南好几处街上的积水没干过，走路的人大多打着油纸伞。
　　车马一过就溅一身泥。有两段路已经垫了碎石，市政厅说等天晴了再彻底翻修。
　　各乡的农活也受了影响，田里的庄稼要等天晴才能收。有个老农说，再下三五天，麦子就要在地里发芽了。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
