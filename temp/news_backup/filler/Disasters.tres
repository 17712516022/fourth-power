[resource]
script = ExtResource("1_7kmgn")
headline = "邻国发水，灾民往南走"
body = "　　据本城跑外的商人说，邻国入夏以来天天下雨，江水漫过堤岸，淹了大片田地，好些村子只剩屋顶露在水面上。
　　灾民成群往南走，沿路讨饭。这几天城里也渐渐能见到他们，多半在车站和教堂门口歇脚。
　　城卫队说，眼下不打算封路，但会在城门口检查。教会已经开始募捐。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
