[resource]
script = ExtResource("1_news")
headline = "神殿祭典开五天"
body = "　　圣光神殿这一届祭典定在本月十八号开始，一共五天。
　　各乡的朝圣者大多已经上路，神殿前面的摊子也都搭好了，卖吃食、蜡烛和护身符的排了一路。
　　殿里的祭司说，今年来朝拜的人比往年少一些，也许是路上不好走。城里的旅馆已经住满。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
