[resource]
script = ExtResource("1_news")
headline = "老铺重新开门"
body = "　　先前门面半掩的那几家，这几天又重新开张，店员陆续回来，早上开门的时候看得见有人拿梯子去摘门板。
　　街上买主渐多，仓里的货陆续出清，最先走的是布和灯油，随后是糖、盐和铁器。有几家把陈货折价摆到门口，一天就卖出大半。
　　店主说，账上的窟窿还在，只是不再往外漏了。商会今天抄了一份重新开门的名单贴在门廊上，有人站在前面数了数，说比上月少两家。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
