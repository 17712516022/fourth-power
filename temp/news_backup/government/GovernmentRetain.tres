[resource]
script = ExtResource("1_news")
headline = "领主亲自去留人"
body = "　　领主今天亲自去了参事家里，坐了半个钟头，把人请了回来。这位参事上个月递了辞呈，说干不下去。
　　谈了什么没人知道。参事下午回了衙门，桌上那摞没批的呈子当天批了一半。
　　衙门里的人说，留人是好事，可光留一个人不够。也有人说，肯亲自跑一趟，总比不跑强。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
