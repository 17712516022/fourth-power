[resource]
script = ExtResource("1_news")
headline = "领主府出钱办厂"
body = "　　领主府今天宣布出钱办两处工场，一处在城南做铁件，一处在河边做砖瓦，招工六百人。
　　钱从城库出，占一半股，另一半招商人入股。工钱按天结，做满三个月加一成。
　　报名的人一早就排到了街口。也有商人说，官家办厂，赔了算谁的。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
