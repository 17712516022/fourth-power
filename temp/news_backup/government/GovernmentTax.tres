[resource]
script = ExtResource("1_news")
headline = "开收街道捐"
body = "　　领主府今天公告，开征市政捐，按房产和铺面的大小收，一年一次，分四季交。
　　一间普通住屋一年交两元，铺面按门脸的宽窄算，最贵的十六元。收来的钱专修街道和沟渠。
　　有房主说，房子漏了三年没人管，先收钱再说修，谁信。公所说，头一季的钱下月就动工。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
