[resource]
script = ExtResource("1_news")
headline = "军警开枪，死伤三十多"
body = "　　昨天傍晚，军警在北区路口向人群开枪，当场死了六人，伤的有三十多，其中几个怕是熬不过夜。
　　军警说，先是有人扔石头、砸了岗亭，警告三次不听才开的枪。在场的人说，人群里多是看热闹的，跑都来不及。
　　今天北区家家关门，街上没人说话。议会没有出面，只在门廊上贴了一张纸，说此事正在查明。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
