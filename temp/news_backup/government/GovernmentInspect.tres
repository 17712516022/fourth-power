[resource]
script = ExtResource("1_news")
headline = "领主府派人查账"
body = "　　领主府今天派了六个查账的人，分头进驻税所、谷仓和河堤工地，账本一律封存。
　　领头的说，查的是这三年的进出，谁经手、谁签字，一笔一笔对。查完会把结果贴在门廊上。
　　税所的人今天脸色不好看，谷仓的管事请了假。街上说，早该查了。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
