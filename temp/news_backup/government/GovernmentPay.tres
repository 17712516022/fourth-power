[resource]
script = ExtResource("1_news")
headline = "补发欠薪和抚恤"
body = "　　领主府今天补发欠下的薪饷，衙门、巡夜队和河堤工地的人先领，一共发了两个月。
　　上月在北区冲突里死伤的人家另外发抚恤：死的八十元，伤的按伤势分二十到四十元。
　　领钱的人排了长队，有人数完钱一句话没说就走了。也有人说，钱是钱，人不回来。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
