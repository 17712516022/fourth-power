[resource]
script = ExtResource("1_news")
headline = "议会发债券"
body = "　　议会昨天发行了一批债券，说要拿这笔钱修河堤、补路，还有一部分给城库周转。
　　债券分五元、十元、五十元三种，年利六个点，三年还本。商会的柜台和两家金行代卖。
　　头一天就卖出去三成。也有商人说，钱收得痛快，可账目得公开，不然下回没人买。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
