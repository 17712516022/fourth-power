[resource]
script = ExtResource("1_news")
headline = "北境棚屋要拆"
body = "　　领主府今天派人清理北境的住区，说是棚屋违建、堵了沟渠，限三天内搬走。
　　一共涉及两百多户，多数是外地来的短工和家小。公所说，愿意回乡的发路费，愿意留下的搬到城西的空地。
　　搬的人不多，多半在观望。有妇女抱着孩子在门口坐着，说家当都在这里，三天能搬到哪儿去。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
