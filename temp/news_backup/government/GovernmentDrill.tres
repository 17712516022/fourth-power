[resource]
script = ExtResource("1_news")
headline = "驻军在城外练兵"
body = "　　城外驻军今天操演，从早上打到中午，炮声传到城里，窗户都震。
　　军营说，这是每年秋天照例的操演，练的是列队、射击和抢救伤员。城门今天开得晚，进出都要查验。
　　城里的狗叫了一天，小孩爬到墙头看。做买卖的抱怨，上午的客人都被炮声吓回去了。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
