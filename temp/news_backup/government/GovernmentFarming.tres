[resource]
script = ExtResource("1_news")
headline = "减了租，还借种子"
body = "　　领主府今天公布劝农三件事：减两成本季地租，种子钱延到明年秋后，各村设一名农事员教轮种和选种。
　　公告说，减租只算本季，明年再议；种子钱不收利，秋后按收成折还。农事员由乡里推，公所发工钱。
　　农夫说，减两成不算多，可是头一回见着纸上写明白。也有庄园主说，减租可以，税也得跟着减。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
