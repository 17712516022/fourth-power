[resource]
script = ExtResource("1_news")
headline = "兵营混乱，西郊闹饷"
body = "　　驻西郊的步兵某营昨天夜里哗变，营里一片混乱，士兵结队出营，说是要饷。哗变的约三百人。
　　起因是昨天早上发饷：军饷按旧例扣了两成，说是补营里的亏空，士兵不服。先是十几个人拥到统领帐前，随后全营大半跟了出来，夺了军械库的钥匙，把统领扣在帐里。
　　议会已经调留守的两个营去西郊围住，另派一名书记官到营门外喊话，答应先把扣掉的两成补发。城中从今天下午起戒严，日落后不许通行。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
