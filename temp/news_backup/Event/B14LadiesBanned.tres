[resource]
script = ExtResource("1_news")
headline = "女子联合会被取缔"
body = "总督府今日宣布女子联合会为非法组织，理由是其“记录行为足以妨害治安”。其会址昨日被搜查，表格、名册、印刷机具一并没收。据在场者说，搜查时屋内只有六人，均在抄录。其中一人问，抄写也犯法吗。未获答复。同日，另有两处支会被查。城中各报今日均未置评。"
image = ExtResource("2_img")
is_big_event = true
big_effect = SubResource("Resource_eff")
