[resource]
script = ExtResource("1_news")
headline = "梅奥郡土地联盟成立，戴维任书记"
body = "梅奥郡农夫今日在卡斯尔镇成立土地联盟，到会代表二百余人，推举戴维为书记。会章三条：减租、护佃、拒驱逐。会址设在一间旧粮行的楼上，楼下还堆着空麻袋。戴维说，这不是请愿的团体，是办事的团体。散会前，书记处向各报分送会章与通告一份，请于明日刊登。散会时，郡内已有十一个村报名入会。郡公所派了一个书记来旁观，从头到尾没有记一个字。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b03_league_founded"
big_effect = SubResource("Resource_eff")
