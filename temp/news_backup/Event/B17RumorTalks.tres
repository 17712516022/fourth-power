script = ExtResource("1_news")
headline = "传狱中正与当局议条件"
body = "城中今日盛传，狱中华莱士正与当局秘密议条件：以停止不交租、谴责暴力，换取释放与旧欠之解决。此说未见任何一方证实。联合会旧部今日分裂为两派，一派称“绝无此事”，一派称“若有，亦是权宜”。本报已向三处求证，两处未复，一处称“无可奉告”。"
image = ExtResource("2_img")
