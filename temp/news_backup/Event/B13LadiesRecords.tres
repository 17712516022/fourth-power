[resource]
script = ExtResource("1_news")
headline = "女子联合会记录驱逐四百余起"
body = "联合会解散后，其女子部另立“女子联合会”，专事记录驱逐。据其自印的表格，两个月内已录四百三十七起，逐条列明郡、村、户主、人口、日期。表格分送各报与外埠。其组织者称，这不是请愿，是记账。总督府今日未作评论。本报已收到第三批，共一百一十二页。"
image = ExtResource("2_img")
is_big_event = true
big_effect = SubResource("Resource_eff")
