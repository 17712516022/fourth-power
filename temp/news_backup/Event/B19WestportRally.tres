[resource]
script = ExtResource("1_news")
headline = "西港集会，华莱士首次到场"
body = "西港镇外今日开了一次大会，到者约四千人，多为附近农夫与小镇店主。议员华莱士自都城赶来，第一次站上土地运动的台子。他说，土地的事不是一郡的事，是全岛的事；又说，只要大家站在一起，就没有哪一个地主敢逐人。台下有人把帽子抛起来。散会时落雨，人群沿码头走回各村，一路唱歌。本报记者数过，台上挂的横幅共十一条，最长的一条写着「土地属于耕者」。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b19_westport_rally"
big_effect = SubResource("Resource_eff")
