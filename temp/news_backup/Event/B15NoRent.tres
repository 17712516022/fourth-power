[resource]
script = ExtResource("1_news")
headline = "狱中发出“不交租”宣言"
body = "本报今日收到一份由狱中带出的宣言，署名华莱士及同监诸人，号召全岛农夫自即日起不交租，并回避土地法庭。宣言未提期限，未提善后。带出者称，此稿须于三日内见报。据西部来信，各地已自行响应，无人统一指挥。本报排字房已排好，未上机。"
image = ExtResource("2_img")
