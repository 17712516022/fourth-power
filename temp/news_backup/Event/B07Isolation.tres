[resource]
script = ExtResource("1_news")
headline = "全郡与一名管事绝往来"
body = "安桥郡一名庄园管事奉令驱逐十一名农夫。此后全郡与他断绝一切往来：雇工不耕其田，店铺不售其物，邮差不送其信，教堂里他两侧的座位空着。据当地人说，这办法是几个村的头人私下议定的，已行了七日。本报记者在报道中用了“孤立”二字——此前各地说的是“不与他往来”，太长了，说不顺口。"
image = ExtResource("2_img")
is_big_event = true
big_effect = SubResource("Resource_eff")
