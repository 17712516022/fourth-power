[resource]
script = ExtResource("1_news")
headline = "女子土地联盟成立，安娜任书记"
body = "女子土地联盟今日在都城成立，到会者二百余人，多为农夫妻女与城镇女工。安娜·华莱士任书记。会章说，男子被捕之后，记录驱逐、募集救济、传递消息的事，由女子接手。会址设在旧书商行三楼，桌上摆着七本空账簿。安娜说，他们可以把人关起来，关不住纸和笔。当场有人认捐，一共认了三十七户的救济。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b23_ladies_league_founded"
big_effect = SubResource("Resource_eff")
