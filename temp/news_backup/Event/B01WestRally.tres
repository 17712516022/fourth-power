[resource]
script = ExtResource("1_news")
headline = "西崖千人集会，抗租与驱逐"
body = "西崖连续两年歉收，农夫聚于伊里镇外的荒地。据在场者说，到者约三千人，携家带口。集会提出三条：租金减四成、停止驱逐、地主不得再收旧欠。地方巡防队在场，未干涉。散后人群沿官道走回各村，一路唱旧调。本报记者昨夜才搭运煤车西行，今日午后抵伊里镇，集会已散，地上留着火堆的灰。"
image = ExtResource("2_img")
is_big_event = true
big_effect = SubResource("Resource_eff")
