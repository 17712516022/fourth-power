[resource]
script = ExtResource("1_news")
headline = "地方报主笔被捕，狱中仍撰稿"
body = "北境一家地方报的主笔昨日被捕，报馆查封，铅字被熔。据其妻说，他在狱中仍每日写稿，由她带出，署名换了一个。稿子写的是本郡的驱逐数目，逐条列出，无一句评论。查封当日，报馆门口聚了百余人，未散。同日，全岛另有四家报馆收到同样的通知。"
image = ExtResource("2_img")
is_big_event = true
big_effect = SubResource("Resource_eff")
