[resource]
script = ExtResource("1_news")
headline = "两名官员公园遇刺，凶器为手术刀"
body = "今日傍晚，两名高级官员在总督府外公园散步时遇刺，均伤及颈动脉，当场死亡。凶器为外科手术刀，凶手四人，二人已被捕。据查，凶器购自外港一家器械行，付款者为一名自称商人的男子，款项自海外汇入。总督府今日闭门。城中各报馆收到通令：此事“暂缓登载”，待查明后再发。本报已排好版。"
image = ExtResource("2_img")
is_big_event = true
big_effect = SubResource("Resource_eff")
