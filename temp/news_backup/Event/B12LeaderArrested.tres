[resource]
script = ExtResource("1_news")
headline = "华莱士被捕，联合会宣布解散"
body = "议员华莱士今日在河口城寓所被捕，押往西郊监狱。同日，总干事戴维及各地支会负责人三十余人一并被捕。总督府宣布联合会为非法组织，即日解散。城中未发生聚集。本报今日头版留白一栏，未填。至夜，有人在该栏位置贴了一张手写的纸，写的是华莱士去年在安桥郡说过的一句话。"
image = ExtResource("2_img")
is_big_event = true
big_effect = SubResource("Resource_eff")
