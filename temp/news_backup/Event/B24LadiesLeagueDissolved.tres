[resource]
script = ExtResource("1_news")
headline = "华莱士获释后解散女子土地联盟"
body = "华莱士获释回到都城后第三日，女子土地联盟在会址开了一次短会。到会者说，华莱士没有来，只送来一封信，说运动已入新阶段，女子联盟的事暂且收束，账簿与名册移交男会。安娜当场把七本账簿抱走，说要留个底。此后三日，各郡支会的女书记陆续收到同样的通知。有人把通知贴在门上，旁边写了一行小字：抄写也犯法，如今不抄了。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b24_ladies_league_dissolved"
big_effect = SubResource("Resource_eff")
