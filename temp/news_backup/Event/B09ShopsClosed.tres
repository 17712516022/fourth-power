[resource]
script = ExtResource("1_news")
headline = "抵制波及店铺，三家歇业"
body = "安桥、克朗两郡的抵制已波及店铺。据郡商会统计，因参与抵制或拒绝参与而歇业者十一户，其中三家为祖业。一名杂货店主说，他被两边各警告过一次：一边说若不停止与某地主交易，就“连他一起孤立”；一边说若继续，就以“妨害治安”报官。他今日关了门，去了外港。本报广告栏今日少了两家。"
image = ExtResource("2_img")
is_big_event = true
big_effect = SubResource("Resource_eff")
