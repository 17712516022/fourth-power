[resource]
script = ExtResource("1_news")
headline = "农夫请愿被拒，联合会称“暂缓”"
body = "西崖农夫二百余人今日到联合会会址请愿，要求将工钱列入会章。书记处答以“暂缓”，称当前首务是减租，工钱事“容后再议”。请愿者于门外坐至黄昏，散去。据一名农夫说，减租减的是有田人的租，他们没有田，减了也与他们无干。本报今日收到该农夫口述一封，请求刊登。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b06_laborers_rejected"
big_effect = SubResource("Resource_eff")
