[resource]
script = ExtResource("1_news")
headline = "安桥郡发驱逐令百余份，村口垒石"
body = "安桥郡昨日发出驱逐通知一百零七份，涉农夫四百余人。各村在路口垒起石墙，妇女立于最前。至午后，三处发生推挤，未开枪。郡巡检称，驱逐系依法执行，抗者以妨害公务论。村中神父出面调停，未果。入夜后，石墙外点起火堆，一直烧到天明。驱逐定于三日后执行。"
image = ExtResource("2_img")
is_big_event = true
big_effect = SubResource("Resource_eff")
