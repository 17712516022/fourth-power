[resource]
script = ExtResource("1_news")
headline = "军队护送五十人入郡收割"
body = "安桥郡的收割在军警护送下开始。五十名外地雇工由两连巡防队护送入郡，日夜守卫，粮车结队而行。据随行军官说，此举系保护“自愿劳动者”。当地农夫立于田埂，未阻拦，未言语。本报记者拍得一张：田里在割麦，田埂上站着一排人，都不说话。照片已制版。"
image = ExtResource("2_img")
is_big_event = true
big_effect = SubResource("Resource_eff")
