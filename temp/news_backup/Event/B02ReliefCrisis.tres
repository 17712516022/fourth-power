[resource]
script = ExtResource("1_news")
headline = "西崖饥荒，教区设粥棚"
body = "西崖沿海各村自入冬起断粮。教区在伊里、克朗两处设粥棚，日济千余人。郡公所拨粮二百石，杯水车薪。本报昨日发起募捐，两日得银四百二十元、粮若干，已交教区。捐款名单将刊于明日副页。有读者来信问：为何不先问一句，粮去了哪里。"
image = ExtResource("2_img")
is_big_event = true
big_effect = SubResource("Resource_eff")
