[resource]
script = ExtResource("1_news")
headline = "纽约汇来款项，联盟账目未明"
body = "本报查到，联盟在纽约设了一个委员会，专收侨民捐款，数月来汇回本岛的款项共四笔，最大一笔折银一千二百元。汇款单上写的是「书款」。联盟书记处说，这是侨民的心意，用来替被逐的人家买粮买煤。海关的人说，账目不清，查也无从查起。城中已有报纸质问：一个替农夫说话的团体，钱从外国来，算不算受人指使。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b21_american_fund"
big_effect = SubResource("Resource_eff")
