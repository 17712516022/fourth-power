[resource]
script = ExtResource("1_news")
headline = "土地法通过，准减租与固定佃权"
body = "《土地法》今日通过：租金由法庭核定，佃权固定，农夫可自由出售其权。领主府称此系“三事俱备”，此后无复租佃之争。联合会旧部号召农夫暂不交租、暂不赴土地法庭，称此法“未及旧欠，未及劳工”。西部响应者众，东部者少。郡议会今日开会，议长说，这是三十年来最好的一部法。"
image = ExtResource("2_img")
is_big_event = true
big_effect = SubResource("Resource_eff")
