[resource]
script = ExtResource("1_news")
headline = "南境恢复正常了"
body = "　　前些天传南境农夫约好抗租不交，这几天各村来人说，租金已经陆续送进谷仓，旧欠也补了不少，有几家连零头都清了。
　　农夫说，议会既然缓征两成，庄园主又把种子钱延到明年秋天，硬拖下去对自己没好处。谷仓管事起初不肯收旧欠，怕惹是非，后来收了，还开了收条。
　　粮行说，租金一清，明春的种子钱就放得出来。今天收进四百多袋，管事说照这个势头，本季的租十天之内能清完。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
