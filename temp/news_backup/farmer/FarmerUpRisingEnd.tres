[resource]
script = ExtResource("1_news")
headline = "东境散了，回去种地"
body = "　　先前聚众的东境已经散了，各乡慢慢恢复正常。带头的几个人由庄园主出面担保领了回去，城卫队没有再追究。
　　三方谈的记录今天贴在议会门廊上：本季地租减两成，种子钱延到明年秋后，谷仓收粮一律给收条。
　　谷仓换了个管事，新管事一早把收条簿摆在门口，谁来送粮都当面开条。有位老人说，今年的租清得比往年还顺。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
