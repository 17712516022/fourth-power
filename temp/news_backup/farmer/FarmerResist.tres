[resource]
script = ExtResource("1_news")
headline = "南境有人想抗租"
body = "　　南境这两天有风声，说不少农夫私下约好抗租，嫌租太重。可这说法散得很，没有凭据：没有带头的，没有请愿书，谷仓前也没人聚集。
　　城里的粮价今天没动，两家粮行挂价和昨天一样，只是来问价的人多了些。村中长老说，农夫之间确实有人走动，但没结社，也没推代表。
　　议会今天说，先按上月定的缓征两成办，不另立章程。当晚议会派了两名文书下乡，先去问各村长老。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
