[resource]
script = ExtResource("1_news")
headline = "各乡恢复正常"
body = "　　前些天慢下来的农活，这几天恢复了。天还没亮，田里就有人声，牛犁走遍各村，该翻的田都翻了。
　　乡里人说，租减了两成，工钱改成十天一结，出力总算有了着落；庄园主那边也说，这一季没误农时。
　　粮行今天挂出的新价比上月略低，说是新粮快上市，先让一点。谷仓今天开仓收粮，头一天收了七十多袋。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
