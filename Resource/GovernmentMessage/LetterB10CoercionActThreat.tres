script = ExtResource("1_msg")
type = 3
displaying_name = "新闻检查官 柯尔"
text = "《治安法》已行。造册报备，三日之内送到本处，不得迟。法案条文，可以登；议中反对之词，不必登。此非请求。贵报若问凭什么，凭的就是这部法。"
event_id = "b10_coercion_act"
