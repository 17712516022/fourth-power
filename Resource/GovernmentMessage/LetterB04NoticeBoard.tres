[ext_resource type="Resource" path="res://Resource/news/GovernmentOfferFakeNew/OfferB04OrderlyTenants.tres" id="2_offer"]

[resource]
script = ExtResource("1_msg")
displaying_name = "新闻检查官 柯尔"
text = "各报都登了联合会的通告，贵报也在其中。本处另拟了一份，措辞平正，请贵报以同一个版位登出。两份并排，读者自会分辨。稿子随信奉上，长短可按贵报的版面删。

（说白了：他要你登「%s」。照办 总督好感+10、影响力+10；不登 总督好感−5、影响力−10。打开信箱时，素材池里会多一张红色稿子，那就是他给的那份。）"
event_id = "b04_notice_board"
offer = ExtResource("2_offer")
metadata/_custom_type_script = "uid://y5yg40g8v8a2"
