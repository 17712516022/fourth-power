script = ExtResource("1_msg")
type = 3
displaying_name = "新闻检查官 柯尔"
text = "狱中带出来的那份东西，本处已经见过。不交租三个字，一个字也不许上报纸。贵报排字房已经排好，本处也知道。今夜之前撤版，还来得及。"
event_id = "b15_no_rent"
