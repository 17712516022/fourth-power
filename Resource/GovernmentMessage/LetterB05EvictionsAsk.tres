[resource]
script = ExtResource("1_msg")
type = 1
displaying_name = "新闻检查官 柯尔"
text = "安桥郡的驱逐，系依法执行，并不是新事。贵报若以「妇女立于最前」为题，各郡怕要误会。请勿渲染，照郡治安官的通报登一简讯就是了。本处不想为难贵报，也不想贵报为难本处。"
event_id = "b05_evictions"
metadata/_custom_type_script = "uid://y5yg40g8v8a2"
