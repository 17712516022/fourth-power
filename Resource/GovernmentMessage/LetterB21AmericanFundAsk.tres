type = 1
displaying_name = "新闻检查官 柯尔"
text = "北港那边汇来的钱，账目不清。贵报若把汇款、捐款、外国资助这些字眼排上版面，商路与汇路都要受影响。还请贵报先放一放，容本处查一查。"
event_id = "b21_american_fund"
