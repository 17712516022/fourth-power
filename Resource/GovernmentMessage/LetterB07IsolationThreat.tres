[gd_resource type="Resource" script_class="GovernmentMessageResource" format=3]

[ext_resource type="Script" uid="uid://y5yg40g8v8a2" path="res://Resource/GovernmentMessage/GovernmentMessage.gd" id="1_msg"]

[resource]
script = ExtResource("1_msg")
type = 3
displaying_name = "新闻检查官 柯尔"
text = "「孤立」二字，是贵报先用的。如今各郡都在用，连公文里也见了。本处不问贵报当初为何造这两个字，只问此后还用不用。再用一次，即以煽动论。下期报纸出来，本处自己会看。"
event_id = "b07_isolation"
metadata/_custom_type_script = "uid://y5yg40g8v8a2"
