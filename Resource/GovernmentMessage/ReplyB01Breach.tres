[resource]
script = ExtResource("1_msg")
type = 4
displaying_name = "新闻检查官 柯尔"
text = "贵报把三千人和那三条要求都写出来了。西崖今日又聚了一次，人数比上回多。本处不说什么，只把这一期报纸存了档。"
