[resource]
script = ExtResource("1_msg")
type = 0
displaying_name = "新闻检查官 柯尔"
text = "安桥郡的收割，是保护自愿劳动者，不是外间所传的那样。贵报所摄的那张图，田埂上站着的那些人，未必是本地的佃农。本处另备一稿，想请贵报照登。肯照登，此事就过去了。"
event_id = "b08_harvest_escort"
offer = ExtResource("2_offer")
metadata/_custom_type_script = "uid://y5yg40g8v8a2"
