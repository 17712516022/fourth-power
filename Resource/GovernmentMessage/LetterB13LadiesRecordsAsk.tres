[resource]
script = ExtResource("1_msg")
type = 1
displaying_name = "新闻检查官 柯尔"
text = "女子联合会所录的表格，名为记账，实为构陷。贵报已收三批，本处知道。请即交回，此后勿再采用。若已排进版面，还望撤下来。本处不想为几页纸，与贵报伤了和气。"
event_id = "b13_ladies_records"
