[resource]
script = ExtResource("1_msg")
type = 1
displaying_name = "新闻检查官 柯尔"
text = "《治安法》已行。造册报备，还望三日之内送到本处。法案条文，可以登；议中反对之词，请暂且按下。贵报若肯体谅，往后送检的事，本处可以替贵报省几道手续。"
event_id = "b10_coercion_act"
metadata/_custom_type_script = "uid://y5yg40g8v8a2"
