[resource]
script = ExtResource("1_news")
headline = "西湾四千人集会"
body = "　　西湾镇外今天开了一次大会，到了约四千人，多是附近的农夫和小镇店主。
　　议员马洛从都城赶来，第一次站上土地运动的台子。他说，土地的事不是一郡的事，是全岛的事；只要大家站在一起，就没有哪个地主敢逐人。
　　台下有人把帽子抛起来。散会时下雨，人群沿码头走回各村，一路唱歌。台上挂了十一条横幅，最长的一条写着“土地属于耕者”。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b19_westport_rally"
big_effect = SubResource("Resource_eff")
