[resource]
script = ExtResource("1_news")
headline = "全郡不理一个管事"
body = "　　安桥郡一个庄园管事奉命驱逐十一名农夫。从那以后，全郡跟他断了来往。
　　雇工不耕他的田，店铺不卖东西给他，邮差不送他的信，教堂里他两边的座位一直空着。这个做法已经行了七天。
　　几个村的头人说，这是私下议定的。本报记者在报道里用了“孤立”两个字——以前各地说的是“不跟他往来”，太长，念着不顺口。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b07_isolation"
big_effect = SubResource("Resource_eff")
