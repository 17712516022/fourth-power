[resource]
script = ExtResource("1_news")
headline = "女子联合会被取缔"
body = "　　总督府今天宣布女子联合会为非法组织，理由是她们的“记录行为足以妨害治安”。
　　会址昨天被搜查，表格、名册、印刷机具一起没收。在场的人说，搜查时屋里只有六个人，都在抄写。
　　其中一个问：抄写也犯法吗。没有人回答。同一天，另有两处支会被查。城里各报今天都没有评论。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b14_ladies_banned"
big_effect = SubResource("Resource_eff")
