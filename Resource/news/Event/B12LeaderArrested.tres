[resource]
script = ExtResource("1_news")
headline = "马洛被捕，联盟解散"
body = "　　议员马洛今天在河口城的寓所被捕，押往西郊监狱。同一天，总干事达恩和各地支会负责人三十多人一起被抓。
　　总督府宣布联合会是非法组织，即日解散。城里没有出现聚集。
　　本报今天的头版留了一栏空白，没有填。到夜里，有人在那块地方贴了一张手写的纸，写的是马洛去年在安桥郡说过的一句话。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b12_leader_arrested"
big_effect = SubResource("Resource_eff")
