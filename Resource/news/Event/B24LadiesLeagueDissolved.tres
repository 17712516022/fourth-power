[resource]
script = ExtResource("1_news")
headline = "女子联盟收了摊"
body = "　　马洛获释回到都城第三天，女子土地联盟在会址开了个短会。
　　到会的人说，马洛没有来，只送来一封信，说运动进了新阶段，女子联盟的事先收一收，账簿和名册交给男会。
　　艾娜当场把七本账簿抱走，说要留个底。此后三天，各郡支会的女书记陆续收到同样的通知。有人把通知贴在门上，旁边写了一行小字：抄写也犯法，如今不抄了。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b24_ladies_league_dissolved"
big_effect = SubResource("Resource_eff")
