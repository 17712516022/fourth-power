[resource]
script = ExtResource("1_news")
headline = "驱逐令贴到村口"
body = "　　安桥郡昨天发出驱逐通知一百零七份，牵涉农夫四百多人。各村在路口垒起石墙，妇女站在最前面。
　　到下午，三处发生推挤，没有开枪。郡治安官说，驱逐是依法办的，阻拦的按妨害公务论。
　　村里的神父出面调停，没成。入夜后石墙外点起火堆，一直烧到天亮。驱逐定在三天后执行。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b05_evictions"
big_effect = SubResource("Resource_eff")
