[resource]
script = ExtResource("1_news")
headline = "女子土地联盟成立"
body = "　　女子土地联盟今天在都城成立，到会二百多人，多是农夫的妻女和城里的女工。艾娜·马洛任书记。
　　会章说，男子被抓以后，记录驱逐、募集救济、传递消息这些事，由女子接手。会址在旧书商行三楼，桌上摆着七本空账簿。
　　艾娜说，他们可以把人关起来，关不住纸和笔。当场有人认捐，一共认下三十七户的救济。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b23_ladies_league_founded"
big_effect = SubResource("Resource_eff")
