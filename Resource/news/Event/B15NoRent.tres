[resource]
script = ExtResource("1_news")
headline = "狱中传出不交租宣言"
body = "　　本报今天收到一份从狱里带出来的宣言，署名是马洛和同监的几个人，号召全岛农夫从今天起不交租，也不去土地法庭。
　　宣言没提期限，也没提以后怎么办。带信的人说，这稿子三天内必须见报。
　　西部来信说，各地已经自己响应，没有人统一指挥。本报排字房已经排好，还没有上机。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b15_no_rent"
big_effect = SubResource("Resource_eff")
