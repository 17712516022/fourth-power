[resource]
script = ExtResource("1_news")
headline = "传狱中在谈条件"
body = "　　城里今天盛传，狱里的马洛正在跟当局秘密谈条件：以停止抗租、谴责暴力，换释放和旧欠的解决。
　　这个说法没有任何一方证实。联合会旧部今天分成两派，一派说“绝无此事”，一派说“就算有，也是权宜之计”。
　　本报向三处求证，两处没有回复，一处说“无可奉告”。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b17_rumor_talks"
big_effect = SubResource("Resource_eff")
