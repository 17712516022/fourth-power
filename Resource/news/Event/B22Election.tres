[resource]
script = ExtResource("1_news")
headline = "马洛三区同时当选"
body = "　　议会解散后的大选今天揭晓。马洛在三个选区同时当选，按规矩只能挑一个，另外两区要补选。
　　联盟各郡支会通夜点票，河口城会址门口挤了三百多人。执政党失去多数，自由党席位大增。
　　郡里几处地主的票仓多半弃权，据说是懒得跑这一趟。本报记者在计票所外站到天亮，马洛本人没有来，只派了一个书记。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b22_election"
big_effect = SubResource("Resource_eff")
