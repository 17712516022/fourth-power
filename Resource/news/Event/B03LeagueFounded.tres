[resource]
script = ExtResource("1_news")
headline = "农夫联盟成立"
body = "　　梅里郡的农夫今天在石堡镇成立土地联盟，到会代表二百多人，推达恩做书记。
　　会章三条：减租、护佃、拒绝驱逐。会址在旧粮行楼上，楼下还堆着空麻袋。达恩说，这不是请愿的团体，是办事的团体。
　　散会前，书记处给各报送了一份会章和通告，请明天登。当天郡里就有十一个村报名入会。郡办事处派了个书记来旁观，从头到尾一个字没记。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b03_league_founded"
big_effect = SubResource("Resource_eff")
