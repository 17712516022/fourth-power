[resource]
script = ExtResource("1_news")
headline = "军队护着五十人割麦"
body = "　　安桥郡的收割在驻军护送下开始了。五十名外地雇工由两连士兵送进郡里，白天夜里都有人守，粮车结队走。
　　随行的军官说，这是保护“自愿劳动者”。当地的农夫站在田埂上，没有拦，也没有说话。
　　本报记者拍到一张：田里在割麦，田埂上站着一排人，都不出声。照片已经制版。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b08_harvest_escort"
big_effect = SubResource("Resource_eff")
