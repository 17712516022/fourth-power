[resource]
script = ExtResource("1_news")
headline = "通告算新闻还是广告"
body = "　　全岛土地联盟今天在河口城成立，到会代表四百多人，推议员马洛做主席，回国的达恩做总干事。
　　散会前，书记处给在场各报送了一份通告，请明天登。本报收到两份，一份给编辑部，一份给广告部。
　　此后十天，全岛三十七家报纸都登了这份通告，占半版，按广告价收一半钱。广告部说，这一栏已经是本报第三大收入。编辑部今天开会，有人问：这算新闻，还是算广告？"
image = ExtResource("2_img")
is_big_event = true
event_id = "b04_notice_board"
big_effect = SubResource("Resource_eff")
