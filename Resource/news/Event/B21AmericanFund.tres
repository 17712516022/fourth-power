[resource]
script = ExtResource("1_news")
headline = "北港汇来四笔钱"
body = "　　本报查到，联盟在北港设了个委员会，专门收侨民捐款。几个月来汇回本岛的钱一共四笔，最大的一笔折合银币一千二百枚。
　　汇款单上写的是“书款”。联盟书记处说，这是侨民的心意，用来给被逐的人家买粮买煤。
　　海关的人说，账目不清，查也无从查起。城里已经有报纸质问：一个替农夫说话的团体，钱从外国来，算不算受人指使。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b21_american_fund"
big_effect = SubResource("Resource_eff")
