[resource]
script = ExtResource("1_news")
headline = "抵制波及店铺"
body = "　　安桥、黑石两郡的抵制波及到店铺。郡商会统计，因为参与抵制或者拒绝参与而关门的有十一户，其中三家是祖上传下来的铺子。
　　一个杂货店主说，他被两边各警告过一次：一边说再跟某地主做生意，就“连他一起孤立”；一边说再不停手，就按“妨害治安”报官。
　　他今天关了门，去了外港。本报广告栏今天少了两家。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b09_shops_closed"
big_effect = SubResource("Resource_eff")
