[resource]
script = ExtResource("1_news")
headline = "西崖断粮，教区发汤"
body = "　　西崖沿海几个村入冬就断了粮。教区在柳溪和黑石搭了两个棚子发汤，一天一千多人来领。
　　郡办事处拨了二百袋粮，摊到各村，根本不够。本报前天发起募捐，两天收了四百二十枚银币，还有一批粮，已经交给教区。
　　捐款名单明天登在副页上。今天有读者来信问：为什么不先问一句，粮到底去了哪里。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b02_relief_crisis"
big_effect = SubResource("Resource_eff")
