[resource]
script = ExtResource("1_news")
headline = "两名官员公园遇刺"
body = "　　今天傍晚，两名高级官员在总督府外的公园散步时遇刺，都伤在颈部，当场死亡。凶手四个人，已经抓到两个。
　　凶器是外科手术刀。查下来，刀是从外港一家器械行买的，付钱的是个自称商人的男子，钱从海外汇来。
　　总督府今天闭门。城里各报社收到通令：这件事“暂缓登载”，等查明再发。本报已经排好版。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b18_park_assassination"
big_effect = SubResource("Resource_eff")
