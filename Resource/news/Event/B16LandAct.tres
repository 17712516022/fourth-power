[resource]
script = ExtResource("1_news")
headline = "土地法通过，租归法庭"
body = "　　《土地法》今天通过：租金由法庭核定，佃权固定下来，农夫可以自由出售自己的佃权。
　　总督府说，这叫“三事俱备”，以后不会再有租佃之争。联合会旧部号召农夫暂时不交租、暂时不去土地法庭，说这部法“没提旧欠，没提劳工”。
　　西部响应的人多，东部少。议会今天开会，议长说，这是三十年来最好的一部法。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b16_land_act"
big_effect = SubResource("Resource_eff")
