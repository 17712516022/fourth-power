[resource]
script = ExtResource("1_news")
headline = "西崖三千人集会"
body = "　　西崖连着两年歉收，三千多农夫带着家小，聚在柳溪镇外的荒地上。
　　集会提了三条：租减四成、停止驱逐、地主不许再收旧欠。驻军在场，从头到尾没动手。
　　散会以后，人群沿大路走回各村，一路唱老调子。本报记者搭运煤车赶到时，人已经散了，地上只剩火堆的灰。"
image = ExtResource("2_img")
is_big_event = true
event_id = "b01_west_rally"
big_effect = SubResource("Resource_eff")
