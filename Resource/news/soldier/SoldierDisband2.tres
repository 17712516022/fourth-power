[resource]
script = ExtResource("1_news")
headline = "某营番号裁撤"
body = "驻西郊某营番号已奉文裁撤。所余兵士或散或并，旧日棚舍多已空置，门额亦经撤去。镇署另调他营填防，然人数不足。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
