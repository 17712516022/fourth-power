[resource]
script = ExtResource("1_news")
headline = "营伍复见整肃"
body = "城西各营自奉到整饬之令，连日加紧训练，营伍复见整肃。营门外闲人尽行驱逐，出入皆有号牌。兵士神色较前稍振。"
