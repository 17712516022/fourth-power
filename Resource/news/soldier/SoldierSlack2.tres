[resource]
script = ExtResource("1_news")
headline = "驻军点名多缺"
body = "驻城各营连日点名，多有缺额，或托病，或径不到。营官虽屡申斥，报病者反日渐多。闻欠饷已及三月，兵士多典衣物。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
