[resource]
script = ExtResource("1_news")
headline = "戍兵索饷，鼓噪出营"
body = "驻防某营兵士以欠饷日久，昨夜鼓噪，结队出营，声言赴城内向镇署索饷。营官劝阻不听，反被推拥。至发稿时，该营尚无归队消息。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
