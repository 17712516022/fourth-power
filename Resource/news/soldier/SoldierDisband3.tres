[resource]
script = ExtResource("1_news")
headline = "溃散之兵，招补无着"
body = "前此溃散之营，虽经出示招补，而来投者寥寥。营门外招兵旗设已半月，登记者不过十余人。有旧兵言：饷既不继，谁肯再入。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
