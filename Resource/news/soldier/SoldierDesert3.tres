[resource]
script = ExtResource("1_news")
headline = "道上多败兵，行李狼藉"
body = "连日往来官道上，多见败兵北去，军装不整，行李狼藉。有售其枪械于乡间者，价极廉。关卡问之，则曰遣散回籍。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
