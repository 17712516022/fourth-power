[resource]
script = ExtResource("1_news")
headline = "营里腐败，账目不清"
body = "　　驻军各营这几天点验，军装和马匹多跟账目对不上，差的数目还不小。营里人都说，这就是腐败。
　　据议会递来的查册，近半年军团报领的军饷跟实际点验的人数差一成上下；营里领的皮甲和长枪，库里实存比簿子上少了一百多件。
　　有队长说，军饷每回发下来都要经过几道手，到士兵手里自然少一些，营里人人都知道，只是没人肯问。议会说，先派一名书记官入营收账，暂时不动人。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
