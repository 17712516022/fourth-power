[resource]
script = ExtResource("1_news")
headline = "变兵缴械，营中复定"
body = "前日哗变之兵今晨缴械回营，听候查办。为首者数人已交军法处。闻欠饷补给半月，余仍悬宕。营中秩序略定，而人人自危。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
