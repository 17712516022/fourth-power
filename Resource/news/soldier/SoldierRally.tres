[resource]
script = ExtResource("1_news")
headline = "溃散残部奉命收拢"
body = "前此溃散之兵，已有残部经沿途收拢归营，人数不及原额之半。枪械多已散失，军装亦不齐备。营官称：尚须数月方能补足编制。"
