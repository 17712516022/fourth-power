[resource]
script = ExtResource("1_news")
headline = "跑了的兵回来了"
body = "　　先前散走的士兵，这几天陆续回营，枪械也点收了一遍。各营实到已经回到九成上下，东门外两处旧营盘也补回了大半。
　　军中重新编了队，缺的队长由老兵升补。有个回来的士兵说，回乡帮工不是长久之计，秋后地里没活，商路上又添了匪，倒不如回营吃粮安稳。
　　也有一百多人索性交了军牌，算是除名。议会说，此后点卯照旧，缺额过两成的营由市政金库另给一笔补人的钱。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
