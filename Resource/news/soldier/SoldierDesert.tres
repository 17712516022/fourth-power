[resource]
script = ExtResource("1_news")
headline = "西郊溃兵四散，乡间屡有劫案"
body = "西郊某营溃散之兵多半未归，散入邻近各县。近日四乡屡报劫案，多者三五成群，持械夜入民家。各地团防已加紧巡缉。"
