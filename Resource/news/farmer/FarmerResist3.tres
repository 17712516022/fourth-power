[resource]
script = ExtResource("1_news")
headline = "秋租将届，各乡观望"
body = "秋收将毕，各乡佃户多不即完租，彼此观望。业户下乡催取，十不得一。有业户言：彼等未必抗违，特欲相持以邀减让耳。"
