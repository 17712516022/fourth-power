[resource]
script = ExtResource("1_news")
headline = "走了的人回来了"
body = "　　先前逃亡走掉的农夫，这几天陆续有人回来。各村册子上记了三十多户，还不到走掉的一两成。田还荒着，草长到膝盖。
　　回来的人说，城里也找不到活，工坊的杂工一天只收几十个，抢不上；住在亲戚家蹭饭，终究不是长法。长老说，回来的人多半没有种子和农具。
　　议会今天说，回籍的农夫可以到村办事处登记，凭登记领一张种子和农具的借用单，秋后按收成折还。今天登记了三十一户，领走种子单二十九张。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
