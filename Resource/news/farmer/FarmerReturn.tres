[resource]
script = ExtResource("1_news")
headline = "四乡渐有归户"
body = "前此弃田出走之户，近日渐有回籍者。所归不过十之一二，田亩依然荒着，草已没膝。里正称：归户多无种子耕具，今年仍难下种。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
