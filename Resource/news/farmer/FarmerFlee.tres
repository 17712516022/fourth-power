[resource]
script = ExtResource("1_news")
headline = "农夫逃亡，丢下地"
body = "　　南境好几个村的农夫整家逃亡，田没人种，草长到膝盖。庄园主起先以为只是过了农忙，等到要犁地，才发现人早就不在村里。
　　村里的册子上，报明迁走的一百四十多户，多半是欠着上一季地租、又借了种子钱的人家。走的时候只带走牲口和铺盖，门窗敞着，锅灶冷着。
　　这几天大路上天天有人推车背包往银钟城去。一个老农说，去年还能打短工补上地租，今年到处减工，补不上，索性不种了。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
