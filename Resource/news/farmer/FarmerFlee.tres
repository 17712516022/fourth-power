[resource]
script = ExtResource("1_news")
headline = "南乡农户弃田出走"
body = "南乡一带近有整户农民弃田出走，所遗田亩无人耕种，草已没膝。据里正报称，逃户约百余家，本年田赋恐难如数征收。"
