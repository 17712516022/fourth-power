script = ExtResource("1_news")
type = null
headline = "西北两乡田亩多荒"
body = "西北两乡自去冬以来，佃户弃田者日众。今春田亩抛荒者已及十之三四，业户欲另招佃种，应者寥寥。所遗草棚多已塌坏。"
