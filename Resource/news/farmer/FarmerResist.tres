[resource]
script = ExtResource("1_news")
headline = "风闻四乡佃户延不缴租"
body = "近日四乡风传，多有佃户相约延不缴租，以诉租额过重。然此说散漫无据，既无首事之人，亦无呈词可查。本埠粮价未见波动。"
