[resource]
script = ExtResource("1_news")
headline = "东境农夫围了谷仓"
body = "　　东境一带闹起动乱，几百个农夫拿着锄头铁叉闯进城外的谷仓，说不交这一季的地租。管事被围在屋里，窗上打碎两块玻璃，仓门的锁被砸开。
　　城卫队和驻军先后赶到，把人劝开。双方僵了约四个钟头，没有人受伤，粮袋也退回仓里。议会派人念了缓征两成的告示，众人还是不肯散。
　　到傍晚，聚着的人退到石板路两边，人数没见少，邻近两个村也传出有人要响应。夜里东境的路上点起了篝火。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
