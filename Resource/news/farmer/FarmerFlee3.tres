[resource]
script = ExtResource("1_news")
headline = "流民过境，乡间十室九空"
body = "连日有流民扶老携幼过境，多称乡间无可为生。沿途村落叩门求食，十室而九空。地方已拨义仓谷石设厂暂赈，然来者日众。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
