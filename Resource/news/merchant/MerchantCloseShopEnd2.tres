[resource]
script = ExtResource("1_news")
headline = "各铺陆续开门"
body = "本埠各铺今日陆续开门，门板次第卸下，街面人声渐起。有铺伙言：新捐已允展缓两月，故不复相持。惟生意较往年仍清淡。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
