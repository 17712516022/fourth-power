[resource]
script = ExtResource("1_news")
headline = "赴外商号渐有回埠"
body = "前此携资他往之商户，近日有数家回埠复业。闻因外埠生意亦淡，而本埠地价已落，反易置产。惟回者尚少，市面未复旧观。"
