[resource]
script = ExtResource("1_news")
headline = "米价暗涨，或有人囤积"
body = "本埠米价旬日之内涨逾一成，而四乡新谷入市未见短少。市中传有数家粮行闭仓不粜，俟价再高。此事无人出首，本埠商会亦未置一词。"
