[resource]
script = ExtResource("1_news")
headline = "米市有行无市"
body = "本埠米市连日挂牌而无成交，行家皆言待价。零买之户奔走数家不得升斗。有老米商叹曰：此非无米，乃米不肯出耳。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
