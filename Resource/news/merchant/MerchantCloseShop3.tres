script = ExtResource("1_news")
headline = "商会传单，约期闭市"
body = "昨有商会传单遍贴各铺，约以本月初五日起闭市三日，以请减免新捐。截至今日午后，签允者已百余家。闻有数家不愿，亦被同业劝阻。"
