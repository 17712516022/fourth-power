[resource]
script = ExtResource("1_news")
headline = "粮价落回来了"
body = "　　本城粮价从上月下旬起渐渐回落，现在已经接近常价。货栈陆续开仓出货，码头这两天一连到了三船麦子。
　　几家先前挂着限购牌子的铺子把牌子摘了，有的还在门口写明现价出售、不限购。有个妇人说，上回买两袋的钱，这回买了三袋还有余。
　　有店主说，先前闭仓那几家是看错了风向：外城的粮并不缺，新麦一上来，压着的货只好往外放，越放越跌。城上的饭馆今天把饭价调回了原价。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
