[resource]
script = ExtResource("1_news")
headline = "三方坐下来谈租子"
body = "　　总督府今天请地主、农夫和商会的代表到议事厅坐下谈，一共来了十四个人，谈了四个钟头。
　　谈的是本季的租额、旧欠怎么算、谷仓收粮给不给收条。没有谈成，只说各让一步，三天后再谈。
　　出来的人说法不一样：地主说已经让到头了，农夫代表说一句实话都没听见。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
