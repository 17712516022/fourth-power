[resource]
script = ExtResource("1_news")
headline = "新政五条"
body = "　　总督府今天公布新政五条：减租两成、缓征旧欠、设仲裁所、开工修堤、北区设夜学。
　　五条都写了期限：减租从本季算，修堤下月动工，夜学冬天开学。钱从市政金库和债券里出。
　　街上贴出来半天，围看的人换了好几拨。有人说，五条都听着好，就怕一条也办不成。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
