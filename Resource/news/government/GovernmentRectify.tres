[resource]
script = ExtResource("1_news")
headline = "官署里整顿风气"
body = "　　总督府今天发文整顿各署：上班不许迟到早退，办事要限期回话，收钱要有单据。
　　各署门口挂了一个木箱，谁被刁难就把状子投进去，每十天开一次。查实的，轻的罚薪，重的撤职。
　　来办事的人今天说，窗口里的人客气了些。也有人说，过一个月再看。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
