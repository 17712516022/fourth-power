[resource]
script = ExtResource("1_news")
headline = "总督请客"
body = "　　总督昨晚在官邸设宴，请了商会的头面人物、行会的几位师傅，还有两个地主的代理人，一共二十来人。
　　席上说了什么，外面不得而知。散席时总督送到门口，只说大家坐下来谈，总比在街上吵好。
　　有赴宴的人说，谈的是工钱和租子，没谈出结果，只说下回再聚。也有人不高兴，说请客不能当政令使。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
