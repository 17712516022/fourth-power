[resource]
script = ExtResource("1_news")
headline = "消费税加了两成"
body = "　　总督府昨天公告，从下月初起加征消费税，酒、糖、盐、灯油和布，一律按售价加两成。
　　税在铺子里收，买家付钱时就带上；铺子每月十五把税银交到办事处，账目要贴出来。瞒报的罚一倍。
　　铺子老板说，加两成，买的人只会少。也有人说，盐和灯油是家家要用的，别又加到穷人头上。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
