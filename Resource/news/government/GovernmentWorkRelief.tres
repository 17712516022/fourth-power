[resource]
script = ExtResource("1_news")
headline = "开工修堤铺路"
body = "　　总督府昨天开了两处工地，一处在南郊河堤，一处在通北区的路上，专收没活干的人。
　　工钱按天结，一天十五铜币，管一顿午饭。上工要先在所在区登记，领一块木牌，凭牌上工。
　　头一天到了四百多人，多是从坊里停下来的和南郊的穷户。有人说，这钱挣得慢，可总比坐着强。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
