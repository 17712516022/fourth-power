[resource]
script = ExtResource("1_news")
headline = "招募民团和巡逻员"
body = "　　总督府今天招募民团和巡逻员，民团三百人，巡逻员一百二十人，按月发饷。
　　民团要求二十到三十岁、身家清白，自带铺盖；巡逻员不限年纪，认得字优先。报名在旧操场。
　　报名的多是找不到活的短工。也有人说，这身衣服穿上，往后见了街坊不好说话。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
