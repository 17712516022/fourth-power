script = ExtResource("1_news")
headline = "县署调兵弹压"
body = "县署昨日调拨防营兵丁分驻城厢及各乡要道，各城门加派岗哨。署中传谕：凡有聚众滋事者，即行拿办。连日城厢行人稀少。"
