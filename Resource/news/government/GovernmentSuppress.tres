[resource]
script = ExtResource("1_news")
headline = "驻军进北区抓人"
body = "　　驻军今天凌晨进北区，抓了四十多人，砸了两个聚会的院子，收走几十捆传单。
　　城卫队说，抓的都是带头的，其余的问过就放。北区今天加了岗，进出要查证件。
　　被抓的人家里在门口站着，不敢多问。工坊里今天到工的人少了一半，机器开得稀稀拉拉。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
