[resource]
script = ExtResource("1_news")
headline = "总督府没人管事"
body = "　　总督府这些天门开着，里面没什么动静。来办事的人在廊下等半天，出来一个书记官，只说管事的不在。
　　递上去的呈子堆了一摞，落款的日子一天比一天早；河堤的工停了，巡夜的班也没人排。
　　街面上的人说，上头大概是出了事。办事处的人不肯讲，只说再过几天就好。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
