[resource]
script = ExtResource("1_news")
headline = "贴告示，护商人"
body = "　　总督府今天在城门和市集贴出告示，说商货进出，任何人不得拦阻、抽税、勒索。
　　告示上说，被拦的商人可以到办事处告，办事处三天内要回话；拦路的人按抢劫办。
　　商人说，告示贴得挺快，就盼着管用。跑外路的车队今天照旧结伴走，不敢单行。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
