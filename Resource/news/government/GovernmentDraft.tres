[resource]
script = ExtResource("1_news")
headline = "议会征兵"
body = "　　议会昨天通过征兵案，二十岁到三十五岁的男子按户抽签，抽中的服一年，可以出钱找人替。
　　替人服役的价钱定在八十银币，由办事处登记，私下交易不算。第一批名额三百人，下月初入营。
　　报名的少，问价的也少。有人算了一笔账：八十银币够一家人吃半年，可谁家拿得出八十银币。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
