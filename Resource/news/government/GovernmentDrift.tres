[resource]
script = ExtResource("1_news")
headline = "一堆事都没下文"
body = "　　河堤的款子拨了三个月，堤上还没见一块新石头；说要修的桥，图纸画好了，木料没到；北区的巡逻队，名册报了，人没招齐。
　　各署的说法都差不多：等上面批，等钱到，等别家先动。
　　街上的人说，官署里天天有人上班，就是不见事情办成。议会的书记官说，下月的会上一并问。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
