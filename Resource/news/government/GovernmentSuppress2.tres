[resource]
script = ExtResource("1_news")
headline = "城厢加岗，入夜戒严"
body = "本埠城厢各街即日起加派岗警，入夜十时以后不许闲人行走，店铺须于九时前上门。城中巡缉队分三班轮流，遇有结队者即行盘问。"
