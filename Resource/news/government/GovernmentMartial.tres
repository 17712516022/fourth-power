[resource]
script = ExtResource("1_news")
headline = "宣布全城戒严"
body = "　　总督府和驻军营今天联合宣布戒严：日落以后不许出门，集会一律禁止，进出城门要通行证。
　　街上加了三处岗哨，巡逻队一夜走四趟。违令的先关三天，再按情节办。
　　天一黑街上就空了，酒馆提前关门。有人说，这么一弄，日子更难过。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
