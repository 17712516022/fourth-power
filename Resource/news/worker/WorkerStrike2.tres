[resource]
script = ExtResource("1_news")
headline = "纱厂工人相率出厂"
body = "昨日下午二时，城东纱厂工人相率出厂，约计七百余人，聚于厂前空地向厂主递送条陈三条：增工钱、减工时、撤换工头。厂主未出面，警区已派警弹压。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
