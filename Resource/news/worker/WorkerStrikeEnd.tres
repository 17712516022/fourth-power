[resource]
script = ExtResource("1_news")
headline = "停工的事了了"
body = "　　东坊停工的事今天了结了。工匠早上陆续进坊，织机从早晨重新转起来，坊门也交还给了坊主。
　　三条要求议定的结果是：去年答应的工钱分两季补发，第一季当场付清；每天加一餐饭，坊主出七成、市政金库贴三成，先试办三个月；停工那三天不算缺工，一个人也不辞。
　　工匠代表说，肯签字是因为钱当场拿到了手里。议会宣布：各坊往后一到冬天就得先议工钱，别拖到开春。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
