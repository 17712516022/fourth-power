[resource]
script = ExtResource("1_news")
headline = "占工坊的人散了"
body = "　　占了坊屋的工匠经商会调解，答应散开，带头的几个人交议会审办。工匠从昨天夜里起分批散去，到中午各处坊门都打开了。
　　坊主回坊里清点，机器大体没坏，只少了铁棍几十根。商会说，散开之前两边议定：工钱当场付一半，剩下的按月摊还；参与的人一个不追究；戒严当天解除。
　　各坊今天开工，算是恢复正常，到工的只有六七成。工坊区的街面上已经看不出异样，只剩桥口还留着一个哨位。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
