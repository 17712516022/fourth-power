script = ExtResource("1_news")
headline = "各厂工人照常上工"
body = "各厂工人现已照常上工，出数如旧。前此稽迟情事，厂中亦不复追问。惟工人每于散工时聚立道旁，议论时局，厂主颇有戒心。"
