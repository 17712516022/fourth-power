script = ExtResource("1_news")
headline = "城东纱厂工人停工"
body = "城东某纱厂工人千余人于昨日辰时停工，推举代表四人，向厂主递一纸诉求，大意谓工钱太薄、工时太长，请自本月起酌加。厂主尚未作答。"
