[resource]
script = ExtResource("1_news")
headline = "城南火警，焚屋十余间"
body = "昨晚十一时，城南草鞋巷某小户遗火于灶，风急延烧，焚去平房十余间，幸未伤人。水会驰救至天明始熄。起火之由尚在查究。"
