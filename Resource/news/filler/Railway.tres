[resource]
script = ExtResource("1_news")
headline = "铁路加开区间车"
body = "本路自本月十六日起，每日加开区间车两对，早七时、午后四时各开一班。三等票价仍旧，头二等照章加价。车至本埠约行一时四十分。"
