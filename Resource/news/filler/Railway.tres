[resource]
script = ExtResource("1_news")
headline = "班车加开两趟"
body = "　　这条路线从本月十六号起，每天加开两班车，早上七点一班，下午四点一班。
　　三等座位票价不变，头等和二等照规矩加价。车到本城大约要走一小时四十分钟。
　　车站说，加开班次是因为入秋以后来往的客商多了，原来的班次常常坐满。车票当天卖，不接受预订。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
