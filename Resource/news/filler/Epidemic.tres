[resource]
script = ExtResource("1_news")
headline = "警察厅布告防疫"
body = "现值时序更迭，警察厅通谕各街巷：沟渠须逐日疏浚，井水须加石灰，染疫之家即报该管警区，勿得隐匿。凡售卖不洁瓜果者，一律禁止。"
