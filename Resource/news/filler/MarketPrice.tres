script = ExtResource("1_news")
headline = "本日米粮行情"
body = "本埠米市今日开盘，上白粳每石报洋四元二角，较昨日涨一角；次白粳三元九角，平。面粉每袋一元八角。杂粮行情散漫，成交清淡。"
