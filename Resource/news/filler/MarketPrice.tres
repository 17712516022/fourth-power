[resource]
script = ExtResource("1_news")
headline = "今日粮价"
body = "　　本城粮市今天开盘，上等白麦每袋四银币二十铜币，比昨天涨了十铜币；次等三银币九十铜币，跟昨天一样。
　　面粉每袋一银币八十铜币，没动。杂粮价钱不稳，买卖清淡，问价的多，掏钱的少。
　　粮行的店员说，白麦涨这一角，是因为前两天下雨，路上不好走，进城的车少了。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
