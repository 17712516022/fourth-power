[resource]
script = ExtResource("1_7kmgn")
headline = "邻省水患，灾民南下"
body = "据本埠商旅来报，邻省入夏大雨，江河水溢，淹没田亩十数万亩。已有灾民结队南下，沿途乞食，近日城中亦渐见其踪迹。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
