[resource]
script = ExtResource("1_news")
headline = "彩券开奖，头奖两千"
body = "　　赈济彩券第七十三期昨天下午三点在商会开奖，中头奖的号码是三四二八七，奖金两千银币。
　　二等奖三名，各三百银币；三等奖二十名，各二十银币。开奖的时候台下挤了三四百人。
　　听说中头奖的那张是城西一家杂货铺买的，铺子老板今天没开门。商会说，这一期卖出的钱一半留作赈济。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
