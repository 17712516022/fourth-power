[resource]
script = ExtResource("1_news")
headline = "西街卖祖传旧画"
body = "　　西街有户人家手头紧，把祖上传下来的画拿出来卖，一共二十多件，昨天送进了拍卖行。
　　最值钱的是一幅老画师画的山水，开价很高。拍卖行的人说，全城出得起这个价的人没几个。
　　听说外城已经有收藏家写信来问，要先看画，再谈价钱。这户人家不肯说姓名，只说急着用钱。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
