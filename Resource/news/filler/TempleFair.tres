script = ExtResource("1_news")
headline = "东岳庙会期已定"
body = "东岳庙本届庙会定于本月十八日起，会期五日。四乡香客多已启程，庙前摊贩棚席业经搭齐。庙祝称今年进香者较往年略减。"
