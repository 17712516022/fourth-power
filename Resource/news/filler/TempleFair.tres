[resource]
script = ExtResource("1_news")
headline = "教堂节庆开五天"
body = "　　圣光教堂这一届节庆定在本月十八号开始，一共五天。
　　各乡的信徒大多已经上路，教堂前面的摊子也都搭好了，卖吃食、蜡烛和圣牌的排了一路。
　　教堂的牧师说，今年来礼拜的人比往年少一些，也许是路上不好走。城里的旅馆已经住满。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
