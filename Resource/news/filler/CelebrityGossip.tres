[resource]
script = ExtResource("1_n3m4f")
headline = "名伶柳月仙闭门谢客"
body = "本埠名伶柳月仙自月初演罢《玉簪记》即闭门谢客，门房只说身子不适。坊间传其将赴上海，亦有言其已许了城东某公馆的堂会。其家仆对本报记者笑而不答。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
