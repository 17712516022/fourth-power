[resource]
script = ExtResource("1_news")
headline = "教团免费发汤"
body = "　　治愈教团在教堂前面搭了个棚子，每天上午八点到十点免费发汤，一人一大碗。老人和身体弱的，另外给半袋麦子。
　　教团说，今年来的人比去年多，粮食和柴火快用完，钱也紧，希望城里人帮一把。账目会贴在棚子旁边，谁都可以看。
　　昨天上午排队的一百多人，队伍从棚子一直排到教堂的台阶底下。一个领汤的老人说，这一碗能顶半天力气。"
image = ExtResource("2_img")
influnce = ExtResource("2_infl")
is_filler = true
