[resource]
script = ExtResource("1_sa4ai")
headline = "连载小说《月落时分》第七回"
body = "上回说到陈生辞别故里，独自往城里去。这一回且说他行至城门，盘缠只剩三枚铜元，守门那两个兵正拿眼上上下下打量他。明日续登。"
