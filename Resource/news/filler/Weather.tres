script = ExtResource("1_tjmaw")
headline = "连日阴雨，街市泥泞"
body = "本埠自入秋以来阴雨连绵，城南数处街面积水未消，行人往来多持油伞。四乡农事亦受牵累，田亩待晴方得收割。"
