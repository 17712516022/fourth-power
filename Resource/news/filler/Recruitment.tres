script = ExtResource("1_news")
headline = "城东纱厂添招女工"
body = "城东纱厂因添置纺机，添招女工六十名，粗工四十名。女工日给洋一角二分，粗工一角。管午饭一顿，工房可寄宿。每日午后二时至六时在厂门口报名。"
