[resource]
script = ExtResource("1_news")
headline = "土地法生效了"
body = "　　《土地法》已经生效：租金改由法庭核定，佃权固定下来，农夫可以自由出售自己的佃权。当局说，这三件事都做到了。
　　从此租佃争执可以走法庭，西部各郡已经开始照着办。土地法庭今天开庭，第一批案子九十多起，全都安排在十天内审完。法庭门口一早排了长队，书记官按郡分栏收状纸。
　　也有联合会的旧人说，这部法没提旧欠，也没提劳工，只解决了一半。议会回应说，这是三十年来最好的一部法，不能因为一时的议论就废掉。"
image = ExtResource("2_img")
influnce = SubResource("Resource_infl")
event_id = "b16_land_act"
