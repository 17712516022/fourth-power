[resource]
script = ExtResource("1_news")
headline = "农夫请愿转到议会"
body = "　　西崖农夫前些天递的请愿书，已经转到议会。议会今天答复说，工钱牵动全郡农事，得让地主、农夫和短工三方坐下来谈，不是一两天能定的。
　　秘书说，请愿书上一共七百多个签名，已经登记编号，先交农业委员会审，再排进议程。三方会谈什么时候开，秘书只说“秋收之后”。代表已经散了，各自回村。
　　郡办事处说，农夫提的要求本来就在日程上，谈不上“拒绝”。可西崖的代表不认：他们要的是一天多少工钱的一句话，不是一句“正在议”。"
image = ExtResource("2_img")
influnce = SubResource("Resource_infl")
event_id = "b06_laborers_rejected"
